<Window x:Class="DiskInspector.UI.Views.CleanupPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mvvm="clr-namespace:DiskInspector.UI.MVVM"
        Title="Prévia Detalhada e Confirmação de Limpeza Segura — DiskInspector"
        Width="980"
        Height="680"
        WindowStartupLocation="CenterOwner"
        Background="#16161A"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <mvvm:RiskToForegroundBrushConverter x:Key="RiskFgConverter" />
        <mvvm:RiskToBackgroundBrushConverter x:Key="RiskBgConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#1F2028" CornerRadius="8" Padding="16" BorderBrush="#2E303E" BorderThickness="1" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Prévia da Limpeza" FontSize="18" FontWeight="SemiBold" Foreground="#F9FAFB" />
                    <TextBlock Text="Nenhum arquivo é excluído sem sua revisão e confirmação explícita. Itens Vermelhos (Alto Risco) e Cinzas (Sistema/Desconhecidos) são bloqueados automaticamente."
                               FontSize="12.5" Foreground="#9CA3AF" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Background="#1A2E22" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="14,8" VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="TOTAL DOS ITENS APROVADOS" FontSize="10" FontWeight="Bold" Foreground="#86EFAC" />
                        <TextBlock x:Name="TxtTotalRecoverable" Text="0 B" FontSize="20" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Avisos de Segurança e Reversibilidade -->
        <Border Grid.Row="1" Background="#292116" BorderBrush="#D97706" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Avisos Importantes sobre o Método de Limpeza e Recuperação:" FontWeight="SemiBold" Foreground="#FBBF24" FontSize="13" />
                <ItemsControl x:Name="WarningsList" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#FDE68A" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Com &quot;Usar Lixeira&quot; ligado, nada é excluído em definitivo: o item que o Windows não puder enviar para a Lixeira (ou que não couber nela) é bloqueado e aparece na lista de itens recusados."
                           Foreground="#D1D5DB" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Abas de Aprovados vs Bloqueados -->
        <TabControl Grid.Row="2" Background="#1E1F26" BorderBrush="#2E303E" BorderThickness="1">
            <TabItem Header="Itens Aprovados para Limpeza" Padding="14,6">
                <DataGrid x:Name="GridApproved"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="#181920"
                          RowBackground="#1E1F26"
                          AlternatingRowBackground="#23252F"
                          Foreground="#E5E7EB"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#2B2D3A"
                          HeadersVisibility="Column"
                          RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Risco" Binding="{Binding Item.ShortRiskBadge, Mode=OneWay}" Width="145" IsReadOnly="True" />
                        <DataGridTextColumn Header="Tamanho" Binding="{Binding FormattedSize, Mode=OneWay}" Width="100" IsReadOnly="True" />
                        <DataGridTextColumn Header="Método de Operação" Binding="{Binding MethodDisplayName, Mode=OneWay}" Width="240" IsReadOnly="True" />
                        <DataGridTextColumn Header="Caminho Completo" Binding="{Binding Item.FullPath, Mode=OneWay}" Width="*" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Itens Bloqueados pelo Guardião de Segurança" Padding="14,6">
                <DataGrid x:Name="GridBlocked"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="#181920"
                          RowBackground="#1E1F26"
                          AlternatingRowBackground="#23252F"
                          Foreground="#FCA5A5"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#2B2D3A"
                          HeadersVisibility="Column"
                          RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Risco" Binding="{Binding Item.ShortRiskBadge, Mode=OneWay}" Width="145" IsReadOnly="True" />
                        <DataGridTextColumn Header="Item" Binding="{Binding Item.Name, Mode=OneWay}" Width="160" IsReadOnly="True" />
                        <DataGridTextColumn Header="Motivo do Bloqueio" Binding="{Binding ValidationMessage, Mode=OneWay}" Width="*" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Caixa de confirmação explícita -->
        <Border Grid.Row="3" Background="#1F2028" BorderBrush="#2E303E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,12">
            <CheckBox x:Name="ChkExplicitConfirm"
                      Foreground="#F3F4F6"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Checked="ChkExplicitConfirm_Changed"
                      Unchecked="ChkExplicitConfirm_Changed"
                      Content="Confirmo que revisei a prévia detalhada acima, fechei os aplicativos relacionados e autorizo a limpeza dos itens aprovados." />
        </Border>

        <!-- Botões de ação -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar (Nenhuma Alteração)"
                    Width="210"
                    Height="38"
                    Margin="0,0,12,0"
                    Background="#2B2D3A"
                    Foreground="#F3F4F6"
                    BorderBrush="#3F4254"
                    Click="BtnCancel_Click" />

            <Button x:Name="BtnConfirmCleanup"
                    Content="Confirmar e Executar Limpeza Segura"
                    Width="260"
                    Height="38"
                    Background="#16A34A"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderBrush="#22C55E"
                    IsEnabled="False"
                    Click="BtnConfirm_Click" />
        </StackPanel>
    </Grid>
</Window>

